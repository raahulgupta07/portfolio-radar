# Where the City MCP Gateway runs
GATEWAY_URL=http://localhost:8000
# Seconds to cache read results per user (data changes once a day)
MCP_CACHE_SECONDS=60

# City SSO, option 1: Keycloak (it can check passwords against LDAP / Active Directory). See docs/sso.md.
OIDC_ISSUER=
OIDC_INTERNAL_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=
SSO_LABEL=

# City SSO, option 2: Microsoft Entra ID. Leave empty until the app registration exists.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Scope of the gateway's API registration, e.g. api://portfolio-radar-gateway/access
ENTRA_API_SCOPE=

# Development sign-in with sample users. Never true in production.
DEV_LOGIN=true
DEV_USERS=[{"token":"dev-viewer","name":"Viewer (sample)","label":"CTO · Steering Committee"},{"token":"dev-approver","name":"PMO Approver (sample)","label":"Approver"},{"token":"dev-admin","name":"Rahul Gupta","label":"Admin"}]
