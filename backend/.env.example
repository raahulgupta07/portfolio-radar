# Defaults for development. Put your own values in backend/.env (not in git); it wins over this file.
# Never commit real secrets. Full list: README.md → "Configuration".
# Unset means prod: dev tokens then do not work.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
# Where source data comes from: mock (sample data) or live (real APIs, later phases)
SOURCE_MODE=mock
SAMPLE_DATA_PATH=../design/sample-data.json
# City SSO for the gateway (or set it in Admin → Connections → City SSO).
# Entra ID: ENTRA_TENANT_ID + ENTRA_AUDIENCE. Keycloak: SSO_PROVIDER=keycloak, OIDC_ISSUER, ENTRA_AUDIENCE.
SSO_PROVIDER=entra
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
OIDC_ISSUER=
OIDC_INTERNAL_ISSUER=
# JSON lists and maps. ENTRA_USER_APPS: client IDs people sign in through (required in production).
ENTRA_USER_APPS=[]
ENTRA_GROUP_ROLES={}
# Dev tokens only work when APP_ENV=dev. Production uses City SSO.
# JSON: token -> {kind: human|agent|service, id, roles}
DEV_TOKENS={"dev-viewer":{"kind":"human","id":"viewer@cityholdings.dev","roles":["viewer"]},"dev-admin":{"kind":"human","id":"admin@cityholdings.dev","roles":["viewer","admin"]},"dev-approver":{"kind":"human","id":"pmo@cityholdings.dev","roles":["viewer","approver"]},"dev-radar":{"kind":"agent","id":"radar","roles":["agent"]},"dev-adapter":{"kind":"service","id":"adapter","roles":["adapter"]},"dev-notifier":{"kind":"service","id":"notifier","roles":["notifier"]},"dev-radar-job":{"kind":"service","id":"radar-job","roles":["radar"]}}
RATE_LIMIT_PER_MINUTE=120

# Secrets pasted in Admin go here. Production: SECRET_STORE=keyvault and KEY_VAULT_URL (managed identity).
SECRET_STORE=local
KEY_VAULT_URL=

# Superadmin: one local account for setting up and when SSO is down (viewer + admin, never approver).
# Empty = off. Production: SUPERADMIN_PASSWORD_HASH from `python -m app.localadmin hash` (SUPERADMIN_PASSWORD
# is refused when APP_ENV=prod).
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
SUPERADMIN_PASSWORD_HASH=
SUPERADMIN_SESSION_MINUTES=60

# Defaults until an admin saves them in Admin → Connections (values there win).
# Radar's words come from an LLM (OpenAI-compatible). Empty = rule-based answers.
# Providers: citygpt, azure_openai, claude, openrouter, other.
# OpenRouter: LLM_PROVIDER=openrouter, LLM_API_KEY=sk-or-..., LLM_MODEL=<id from openrouter.ai/models>
#   (LLM_BASE_URL is then https://openrouter.ai/api/v1 by itself).
LLM_PROVIDER=citygpt
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_APP_URL=
# Notifier channels for approved drafts. Empty in dev = written to the worker log.
TEAMS_WEBHOOK_URL=
SMTP_HOST=
NOTIFY_EMAIL_TO=[]
