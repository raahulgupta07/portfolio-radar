# Copy to .env for local runs. Never commit real secrets.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
# Where source data comes from: mock (sample data) or live (real APIs, later phases)
SOURCE_MODE=mock
SAMPLE_DATA_PATH=../design/sample-data.json
# Dev tokens only work when APP_ENV=dev. Production uses City SSO (Entra ID).
# JSON: token -> {kind: human|agent|service, id, roles}
DEV_TOKENS={"dev-viewer":{"kind":"human","id":"viewer@cityholdings.dev","roles":["viewer"]},"dev-admin":{"kind":"human","id":"admin@cityholdings.dev","roles":["viewer","admin"]},"dev-approver":{"kind":"human","id":"pmo@cityholdings.dev","roles":["viewer","approver"]},"dev-radar":{"kind":"agent","id":"radar","roles":["agent"]},"dev-adapter":{"kind":"service","id":"adapter","roles":["adapter"]},"dev-notifier":{"kind":"service","id":"notifier","roles":["notifier"]}}
RATE_LIMIT_PER_MINUTE=120
